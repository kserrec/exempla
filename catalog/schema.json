{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kserrec/exempla/blob/main/catalog/schema.json",
  "title": "Exempla learner-centered language catalog",
  "type": "object",
  "required": ["schema_version", "language_slug", "repositories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 5},
    "language_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "repositories": {"type": "array", "items": {"$ref": "#/$defs/repository"}}
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\/$)(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?![^/]*\\.[eE][nN][vV](?:\\.[^/]*)?(?:/|$))(?!.*\\/[^/]*\\.[eE][nN][vV](?:\\.[^/]*)?(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/nonEmptyString"}
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "signals", "reason"],
      "properties": {
        "score": {"$ref": "#/$defs/score"},
        "signals": {"$ref": "#/$defs/stringList"},
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "noviceAccessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["floor", "central_concepts", "incidental_concepts", "reason"],
      "properties": {
        "floor": {"type": "integer", "minimum": 1, "maximum": 3},
        "central_concepts": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "incidental_concepts": {
          "type": "array",
          "items": {"$ref": "#/$defs/nonEmptyString"}
        },
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_quality",
        "architecture",
        "naming_and_idiom",
        "tests",
        "documentation",
        "traceability",
        "maintainability",
        "educational_value"
      ],
      "properties": {
        "source_quality": {"$ref": "#/$defs/nonEmptyString"},
        "architecture": {"$ref": "#/$defs/nonEmptyString"},
        "naming_and_idiom": {"$ref": "#/$defs/nonEmptyString"},
        "tests": {"$ref": "#/$defs/nonEmptyString"},
        "documentation": {"$ref": "#/$defs/nonEmptyString"},
        "traceability": {"$ref": "#/$defs/nonEmptyString"},
        "maintainability": {"$ref": "#/$defs/nonEmptyString"},
        "educational_value": {"$ref": "#/$defs/nonEmptyString"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "path_slug",
        "repository",
        "url",
        "primary_language",
        "language_evidence",
        "description",
        "source_kind",
        "purpose_evidence",
        "why_study",
        "learn",
        "prerequisites",
        "concepts_developed",
        "coding_relevance",
        "learning_path",
        "learning_level",
        "quality",
        "inspection",
        "license",
        "github"
      ],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "path_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$"},
        "primary_language": {"$ref": "#/$defs/nonEmptyString"},
        "language_evidence": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "source_kind": {"enum": ["production", "educational-exemplar"]},
        "purpose_evidence": {"$ref": "#/$defs/nonEmptyString"},
        "why_study": {"$ref": "#/$defs/nonEmptyString"},
        "quick_start": {"$ref": "#/$defs/nonEmptyString"},
        "learn": {"$ref": "#/$defs/stringList"},
        "prerequisites": {"$ref": "#/$defs/stringList"},
        "concepts_developed": {"$ref": "#/$defs/stringList"},
        "coding_relevance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gate", "domain_context", "reason"],
          "properties": {
            "gate": {"const": "pass"},
            "domain_context": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
            "reason": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "learning_path": {
          "type": "object",
          "additionalProperties": false,
          "required": ["goal", "start_here", "supporting_files", "trace"],
          "properties": {
            "goal": {"$ref": "#/$defs/nonEmptyString"},
            "start_here": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "reason"],
              "properties": {
                "path": {"$ref": "#/$defs/safePath"},
                "line_start": {"type": "integer", "minimum": 1},
                "line_end": {"type": "integer", "minimum": 1},
                "reason": {"$ref": "#/$defs/nonEmptyString"}
              }
            },
            "supporting_files": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/safePath"}
            },
            "trace": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "learning_level": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "language_technique",
            "behavioral_reasoning",
            "design_span",
            "constraint_burden",
            "placement"
          ],
          "properties": {
            "level": {"$ref": "#/$defs/score"},
            "language_technique": {"$ref": "#/$defs/judgment"},
            "behavioral_reasoning": {"$ref": "#/$defs/judgment"},
            "design_span": {"$ref": "#/$defs/judgment"},
            "constraint_burden": {"$ref": "#/$defs/judgment"},
            "placement": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "novice_accessibility": {"$ref": "#/$defs/noviceAccessibility"},
        "quality": {"$ref": "#/$defs/quality"},
        "inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "inspected_at", "reviewers", "files"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "inspected_at": {"type": "string", "format": "date"},
            "reviewers": {"$ref": "#/$defs/stringList"},
            "files": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/safePath"}
            }
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "urls"],
          "properties": {
            "spdx": {"$ref": "#/$defs/nonEmptyString"},
            "urls": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^https://github\\.com/"}
            }
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_language", "archived", "metadata_checked_at"],
          "properties": {
            "primary_language": {"$ref": "#/$defs/nonEmptyString"},
            "archived": {"type": "boolean"},
            "metadata_checked_at": {"type": "string", "format": "date"}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"source_kind": {"const": "educational-exemplar"}},
            "required": ["source_kind"]
          },
          "then": {
            "required": ["novice_accessibility"],
            "properties": {
              "learning_level": {
                "properties": {"level": {"enum": [1, 2]}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "learning_level": {
                "properties": {"level": {"enum": [1, 2]}},
                "required": ["level"]
              }
            },
            "required": ["learning_level"]
          },
          "then": {
            "required": ["quick_start"],
            "properties": {
              "learning_path": {
                "properties": {
                  "start_here": {
                    "required": ["path", "line_start", "line_end", "reason"]
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
