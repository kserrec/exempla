{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kserrec/exempla/blob/main/catalog/schema.json",
  "title": "Exempla language catalog",
  "type": "object",
  "required": ["schema_version", "language_slug", "repositories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "language_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "repositories": {
      "type": "array",
      "items": {"$ref": "#/$defs/repository"}
    }
  },
  "$defs": {
    "nonEmptyString": {"type": "string", "minLength": 1},
    "score": {"type": "integer", "minimum": 1, "maximum": 5},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug", "repository", "url", "primary_language", "language_evidence", "description",
        "real_world_evidence", "why_study", "learn", "prerequisites",
        "start_here", "sdc", "quality", "inspection", "license", "github"
      ],
      "properties": {
        "slug": {"$ref": "#/$defs/nonEmptyString"},
        "repository": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
        "url": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$"},
        "primary_language": {"$ref": "#/$defs/nonEmptyString"},
        "language_evidence": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"$ref": "#/$defs/nonEmptyString"},
        "real_world_evidence": {"$ref": "#/$defs/nonEmptyString"},
        "why_study": {"$ref": "#/$defs/nonEmptyString"},
        "learn": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "prerequisites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "start_here": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "reason"],
          "properties": {
            "path": {"$ref": "#/$defs/nonEmptyString"},
            "reason": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "sdc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "size", "difficulty", "complexity", "placement"],
          "properties": {
            "level": {"$ref": "#/$defs/score"},
            "size": {
              "type": "object",
              "additionalProperties": false,
              "required": ["score", "loc", "tool", "measured_at", "exclusions", "notes"],
              "properties": {
                "score": {"$ref": "#/$defs/score"},
                "loc": {"type": "integer", "minimum": 1},
                "tool": {"$ref": "#/$defs/nonEmptyString"},
                "measured_at": {"type": "string", "format": "date"},
                "exclusions": {"type": "array", "items": {"$ref": "#/$defs/nonEmptyString"}},
                "notes": {"$ref": "#/$defs/nonEmptyString"}
              }
            },
            "difficulty": {"$ref": "#/$defs/judgment"},
            "complexity": {"$ref": "#/$defs/judgment"},
            "placement": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_quality", "architecture", "naming_and_idiom", "tests", "documentation", "traceability", "maintainability", "educational_value"],
          "properties": {
            "source_quality": {"$ref": "#/$defs/nonEmptyString"},
            "architecture": {"$ref": "#/$defs/nonEmptyString"},
            "naming_and_idiom": {"$ref": "#/$defs/nonEmptyString"},
            "tests": {"$ref": "#/$defs/nonEmptyString"},
            "documentation": {"$ref": "#/$defs/nonEmptyString"},
            "traceability": {"$ref": "#/$defs/nonEmptyString"},
            "maintainability": {"$ref": "#/$defs/nonEmptyString"},
            "educational_value": {"$ref": "#/$defs/nonEmptyString"}
          }
        },
        "inspection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "inspected_at", "reviewers", "files"],
          "properties": {
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "inspected_at": {"type": "string", "format": "date"},
            "reviewers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
            "files": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/nonEmptyString"}}
          }
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "url"],
          "properties": {
            "spdx": {"$ref": "#/$defs/nonEmptyString"},
            "url": {"type": "string", "pattern": "^https://github\\.com/"}
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary_language", "archived", "metadata_checked_at"],
          "properties": {
            "primary_language": {"$ref": "#/$defs/nonEmptyString"},
            "archived": {"type": "boolean"},
            "metadata_checked_at": {"type": "string", "format": "date"}
          }
        }
      }
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "signals", "reason"],
      "properties": {
        "score": {"$ref": "#/$defs/score"},
        "signals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonEmptyString"}},
        "reason": {"$ref": "#/$defs/nonEmptyString"}
      }
    }
  }
}
